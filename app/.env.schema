# Variables kurasu reads. Checked in, without secret values: local values go in
# .env.local and production values in .env.production.local, both out of git.
# Validate with `pnpm exec varlock load`; run a command with the values injected
# with `pnpm exec varlock run -- <command>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Which set of values applies: development for alchemy dev and the tests,
# production for the deploy of the prod stage.
# @type=enum(development, production)
APP_ENV=development

# HS256 key that signs the JWT in the session cookie. Every stage has its own;
# the deploy of prod stops before touching anything when it is missing.
# @sensitive @required=forEnv(production) @type=string(minLength=32)
JWT_SECRET=

# Hostname shared by the web and the API; the magic link mail goes out from
# no-reply@ on it.
# @type=string
KURASU_DOMAIN=kurasu.asermax.com

# Origin of the web, where the magic link and the enrollment QR point. The
# deployed stage uses the domain; alchemy dev uses the local Vite server.
# @type=url
KURASU_WEB_ORIGIN=if(eq($APP_ENV, production), concat("https://", $KURASU_DOMAIN), "http://localhost:5173")

# Only for the API tests: the addresses the mail binding may send to, separated
# by commas. Unset, the binding sends to any address.
# @type=string
KURASU_MAIL_ALLOWED_DESTINATIONS=

# Only for the API tests: SQL files to load into D1 after the migrations,
# separated by commas, so each test stage starts from its own fixtures.
# @type=string
KURASU_D1_IMPORT_FILES=
